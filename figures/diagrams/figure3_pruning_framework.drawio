<mxfile host="app.diagrams.net"><diagram name="Figure 3"><mxGraphModel dx="1450" dy="745" grid="1" gridSize="10" page="1" pageWidth="1450" pageHeight="745" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Pruned End-to-End Baseline" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#333333;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="12" width="955" height="180" as="geometry"/></mxCell><mxCell id="c3" value="Pruned Two-Stage Supervised Contrastive Learning" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#333333;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="210" width="955" height="525" as="geometry"/></mxCell><mxCell id="c4" value="Stage 1: Contrastive pre-training (encoder + projection head trained)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#333333;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontStyle=1;fontSize=12;align=right;" vertex="1" parent="1"><mxGeometry x="498" y="245" width="920" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Stage 2: Classifier training and pruning (encoder frozen)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#333333;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontStyle=1;fontSize=12;align=right;" vertex="1" parent="1"><mxGeometry x="498" y="410" width="920" height="305" as="geometry"/></mxCell><mxCell id="imgs" value="&lt;b&gt;&lt;font style=&#x27;font-size:18px&#x27;&gt;Training Images&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;(paste sign-image grid here)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="230" height="330" as="geometry"/></mxCell><mxCell id="pre" value="&lt;b&gt;Preprocessed Images:&lt;/b&gt;&lt;br&gt;224×224×3 and&lt;br&gt;augmentation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285" y="305" width="150" height="75" as="geometry"/></mxCell><mxCell id="t_mod" value="&lt;b&gt;Trained Baseline&lt;br&gt;Model&lt;/b&gt;&lt;br&gt;(encoder + classifier,&lt;br&gt;trained as in Fig. 1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="135" height="70" as="geometry"/></mxCell><mxCell id="t_msk" value="&lt;b&gt;Applying Pruning&lt;br&gt;Mask:&lt;/b&gt;&lt;br&gt;Dense layers only&lt;br&gt;(30% → 80%)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="125" height="70" as="geometry"/></mxCell><mxCell id="t_ft" value="&lt;b&gt;Pruning&lt;br&gt;Fine-tuning:&lt;/b&gt;&lt;br&gt;30 epochs,&lt;br&gt;all weights updated" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="125" height="70" as="geometry"/></mxCell><mxCell id="t_sel" value="&lt;b&gt;Model Selection:&lt;/b&gt;&lt;br&gt;lowest val. loss&lt;br&gt;after 80% sparsity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="135" height="70" as="geometry"/></mxCell><mxCell id="t_str" value="&lt;b&gt;Strip Pruning&lt;br&gt;Wrappers&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="120" height="70" as="geometry"/></mxCell><mxCell id="t_tst" value="&lt;b&gt;Testing &amp;amp; An